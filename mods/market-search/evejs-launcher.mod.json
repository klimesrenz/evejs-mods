{
  "schemaVersion": 3,
  "id": "market-search",
  "displayName": "Market Search",
  "version": "0.1.3",
  "description": "In-game item search across NPC station markets, stargate distances and destination selection.",
  "kind": "loader",
  "supportedBackends": [
    "native"
  ],
  "activation": {
    "strategy": "loader_rename"
  },
  "restart": "game_server",
  "compatibility": {
    "evejsVersions": [
      "0.12.6",
      "0.12.7.1",
      "0.12.8",
      "0.12.9",
      "0.12.19"
    ]
  },
  "launcherApi": {
    "version": 1,
    "minLauncherVersion": "1.0.69",
    "helper": {
      "runtime": "node",
      "path": "helper.js"
    },
    "capabilities": [
      "install",
      "verify",
      "prepare_profile",
      "prepare_disable",
      "prepare_remove",
      "recover"
    ]
  },
  "clientMenu": {
    "apiVersion": 1,
    "entrypoint": "client/menu.py"
  },
  "updates": {
    "provider": "github",
    "repository": "klimesrenz/evejs-mods",
    "asset": "MarketSearch-{version}.zip",
    "channel": "stable",
    "tagPrefix": "market-search-v",
    "preserveFiles": []
  }
}
